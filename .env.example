OPENAI_API_KEY=your-key-here

# LLM used by the policy and drafting agents. Check the price on platform.openai.com/docs/pricing.
LLM_MODEL=gpt-5.6-luna
LLM_INPUT_PRICE_PER_M=2.0
LLM_OUTPUT_PRICE_PER_M=12.0
# No LLM call is made once total spend reaches this (ledger in data/llm_spend.json).
LLM_SPEND_CAP_USD=5.0

# Share of complaints sent to a human for product triage (threshold is set on train).
TARGET_ESCALATION_RATE=0.2

# Audit log. Leave unset for SQLite at data/audit.db, or use the docker-compose Postgres:
# DATABASE_URL=postgresql+psycopg://complaints:complaints@localhost:5432/complaints

# LangSmith tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_PROJECT=complaint-resolution-agent
